{
  "name": "7studyspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server \"vite --host 127.0.0.1\" \"node server/index.mjs\"",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test tests/*.test.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "express": "^5.1.0",
    "idb": "^8.0.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
