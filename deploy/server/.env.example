# Choose one canonical hostname, without https://, a slash, or a port.
STUDY77_DOMAIN=study.example.com
ACME_EMAIL=you@example.com

# Absolute persistent paths on the server, outside the Git checkout.
# Create both directories with owner UID/GID 1000 and permissions 0700.
STUDY77_DATA_PATH=/srv/study77/data
STUDY77_BACKUP_PATH=/srv/study77/backups
